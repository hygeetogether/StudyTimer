## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.env

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
[Ll]og/
*.log
*.ide
*.vspscc
*.vssscc
*.builds
*.pidb
*.booproj
*.csproj.user
*.project.json.user
*.xproj.user
*.dbmdl
*.jfm

# Visual Studio 2017 and above
.vs/

# Packages
packages/

